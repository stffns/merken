.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Editors
.vscode/
.idea/
*.swp
.DS_Store

# Local agent / tool state -- not part of the project source tree
.claude/
AGENTS.md

# vstash / merken local data
*.db
*.db-journal
*.db-wal
*.db-shm
.merken/
.engram/

# Old package name (pip install -e . can regenerate it)
engram/

# Benchmark dataset cache
experiments/**/.cache/

# Benchmark run logs (raw output; curated results go in RESULTS.md)
experiments/**/runs/

# Role-geometry generated scenarios (regeneratable from gen.py + vocab*.json,
# sha256 in aggregate_summary.json covers reproducibility).
experiments/role_geometry/scenarios_disjoint/generated/
experiments/retrieval/locomo/data/
experiments/retrieval/locomo/results_detail.json

# Midloop pilot artifacts (regeneratable; some contain copyrighted
# WHO source text staged for local clause-chunking).
experiments/midloop_pilot/staging/
experiments/midloop_pilot/scaleup_out/
experiments/midloop_pilot/out/
experiments/midloop_pilot/training_data/

# Training-data extracts from merken_labels across projects. Contains
# private transcript snippets; regeneratable via
# experiments/extract_labels_to_jsonl.py. Anchored to repo root so
# `merken/data/` (bundled package data, e.g. role classifier prototypes)
# stays tracked.
/data/
*.jsonl

# Mode C demo / benchmark local artifacts (regeneratable; auto-written
# by mode_c_demo.py and mode_c_benchmark.py).
experiments/midloop_concept/medlocal/mode_c_demo_last.json
experiments/midloop_concept/medlocal/phase0*_report.json

# bge LoRA fine-tune artifacts (adapter weights regeneratable from
# build_contrastive_pairs.py + train_lora.py).
experiments/retrieval/bge_lme_ft/adapters/

# nanoGPT training outputs (weights + logs, regeneratable from training scripts).
experiments/nanogpt/*.log
experiments/nanogpt/v8c_frozen_encoder/

# pipeline_runner and mode_c_benchmark per-run outputs (jsonl ignored
# globally, but this dir also accumulates .log / .summary.json files
# that are per-experiment artifacts -- regeneratable via the runners).
experiments/retrieval/longmemeval/pipeline_runs/

# LoCoMo Phase 2 per-run outputs (same shape as longmemeval/pipeline_runs).
# Regeneratable via runner_phase2.py / runner_rerank.py / runner_minimal.py.
experiments/retrieval/locomo/phase2_runs/
experiments/retrieval/locomo/miss_analysis_v1.jsonl

# Phase 2 training data: small (~2MB) and needed in-repo so Colab can
# git-clone and access it without manual upload. Overrides the global
# *.jsonl ignore for this specific folder.
!experiments/phase2_training/data/
!experiments/phase2_training/data/*.jsonl

# Phase 2 trained artifacts (LoRA adapter + MLX-quantized fused model).
# Regeneratable from the Colab notebook + fuse_to_mlx.py.
experiments/phase2_training/adapter/
experiments/phase2_training/adapter_pa/
experiments/phase2_training/smollm3_ft_mlx_q4/
experiments/phase2_training/smollm3_pa_mlx_q4/
experiments/phase2_training/*_merged_hf/

# Jev response cache written by experiments/loop_quality/jev_probe.py
.jev_cache/
